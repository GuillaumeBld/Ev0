# Database
DATABASE_URL=postgresql://ev0:ev0_dev_password@localhost:5432/ev0

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated)
CORS_ORIGINS_STR=http://localhost:3000

# ============ DATA INGESTION APIs ============

# Firecrawl - Web scraping with JS rendering (https://firecrawl.dev)
# Required for Main and Fallback strategies
FIRECRAWL_API_KEY=

# OpenRouter - LLM for parsing scraped HTML (https://openrouter.ai)
# Required for Main and Fallback strategies
OPENROUTER_API_KEY=

# API-Football - Reliable football data (https://www.api-football.com)
# Required for Main strategy, optional for Fallback
API_FOOTBALL_KEY=

# LLM Parser model (default: claude-3-5-sonnet for fast extraction)
LLM_PARSER_MODEL=anthropic/claude-sonnet-4-20250514

# ============ OTHER APIs ============

# Odds API (optional - for live betting odds)
ODDS_API_KEY=

# Pricing parameters
GOALSCORER_DECAY_LAMBDA=0.025
ASSIST_DECAY_LAMBDA=0.017
MIN_EDGE_THRESHOLD=0.05

# ============ NOTIFICATIONS TELEGRAM ============
# Un groupe par canal. Vide -> repli sur TELEGRAM_CHAT_ID, message préfixé
# [canal] + log WARNING (jamais d'échec silencieux).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=           # chat historique — filet de secours
TELEGRAM_CHAT_ID_VALUE=     # mouvements de marché (sonore)
TELEGRAM_CHAT_ID_INCIDENTS= # pannes à traiter (sonore)
TELEGRAM_CHAT_ID_AUTOPILOT= # activité autonome (à mettre en sourdine)
