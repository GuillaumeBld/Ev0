FROM python:3.11-slim

WORKDIR /app

# System dependencies: build tools + Chromium runtime libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    # Chromium dependencies for Playwright
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxext6 \
    fonts-liberation \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (including playwright)
COPY pyproject.toml .
RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir "playwright>=1.40.0" && \
    playwright install chromium

# Cache buster — increment on each deploy
ARG CACHE_BUST=1

# Copy application code
COPY . .

CMD ["python", "-m", "app.worker"]
