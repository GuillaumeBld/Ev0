# ── Required: Set these in Dokploy environment variables ──

# PostgreSQL
POSTGRES_USER=ev0
POSTGRES_PASSWORD=          # Generate: openssl rand -base64 24
POSTGRES_DB=ev0
DATABASE_URL=postgresql://ev0:YOUR_PASSWORD_HERE@db:5432/ev0

# Redis (optional password)
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=           # Uncomment to enable Redis auth

# CORS
CORS_ORIGINS_STR=https://your-domain.com

# API Keys
ODDS_API_KEY=               # Get from https://the-odds-api.com
FIRECRAWL_API_KEY=          # Optional
OPENROUTER_API_KEY=         # Optional
API_FOOTBALL_KEY=           # Optional

# Frontend Auth
NEXTAUTH_SECRET=            # Generate: openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=             # Choose a strong password

# ── Notifications Telegram — un groupe par canal ──
# Créer 3 groupes (🎯 Value, 🚨 Incidents, 🤖 Autopilot), y ajouter le bot,
# puis relever les chat_id (négatifs pour un groupe) :
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | python3 -m json.tool
# Si une variable est vide, le canal se replie sur TELEGRAM_CHAT_ID avec un
# préfixe [canal] et un log WARNING — rien n'est jamais perdu en silence.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=           # chat historique — filet de secours
TELEGRAM_CHAT_ID_VALUE=     # mouvements de marché (sonore)
TELEGRAM_CHAT_ID_INCIDENTS= # pannes à traiter (sonore)
TELEGRAM_CHAT_ID_AUTOPILOT= # activité autonome (à mettre en sourdine)
